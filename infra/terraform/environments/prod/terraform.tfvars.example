project_id  = "production-gcp-project-id"
region      = "europe-west10"
zone        = "europe-west10-a"
name_prefix = "service-launchpad"

labels = {
  owner       = "platform"
  environment = "prod"
}

# Production network shape.
subnet_ip_cidr_range = "10.30.0.0/24"
secondary_ip_ranges = [
  {
    range_name    = "pods"
    ip_cidr_range = "10.40.0.0/20"
  },
  {
    range_name    = "services"
    ip_cidr_range = "10.41.0.0/24"
  },
]

# Production identities.
control_plane_service_account_id = "slp-prod-control-plane"
gke_node_service_account_id      = "slp-prod-gke-node"

# Production GKE shape.
gke_cluster_enabled         = true
gke_cluster_name            = "service-launchpad-prod-gke"
gke_deletion_protection     = false
gke_enable_private_nodes    = true
gke_enable_private_endpoint = true
gke_master_ipv4_cidr_block  = "172.16.0.0/28"
gke_release_channel         = "REGULAR"
gke_node_locations          = ["europe-west10-a"]
gke_node_count              = 1
gke_node_machine_type       = "e2-standard-2"
gke_node_disk_size_gb       = 50

# Required if gke_enable_private_endpoint = false. Use the operator/VPN/NAT
# egress CIDRs that should be allowed to reach the GKE Kubernetes API.
gke_master_authorized_networks = [
  # {
  #   cidr_block   = "203.0.113.10/32"
  #   display_name = "platform-operator"
  # },
]

# Production artifact bucket. The final bucket name must be globally unique.
artifact_registry_repository_id = "service-launchpad"
production_image_tag            = "prod"
artifact_bucket_name          = "production-service-launchpad-artifacts"
artifact_bucket_force_destroy = false

# Future Task 32 Cloud Run control-plane settings will add variables such as:
# control_plane_target_namespace
# control_plane_container_image
# control_plane_ingress
# control_plane_enable_vpc_egress
# control_plane_invoker_members
# control_plane_kube_api_server
# control_plane_kube_ca_data
